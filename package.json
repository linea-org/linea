{
  "name": "linea",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "lint": "turbo lint",
    "format:check": "prettier --check . '!pnpm-lock.yaml'",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:pack": "pnpm --filter @linealabs/sdk --filter @linealabs/sdk-react test:pack",
    "generate:contracts": "pnpm --filter @linealabs/protocol build && node packages/protocol/scripts/generate-public-contracts.mjs",
    "check:contracts": "pnpm --filter @linealabs/protocol build && node packages/protocol/scripts/generate-public-contracts.mjs --check"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.12",
    "typescript": "^6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "24.22.1"
  },
  "prettier": {
    "endOfLine": "lf",
    "semi": false,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 80
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@2": "^2.1.6",
      "baseline-browser-mapping": "2.11.25",
      "body-parser@2": "^2.4.0",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "browserslist": "4.29.0",
      "engine.io@6": "^6.6.10",
      "esbuild": "0.28.1",
      "fast-uri": "^3.1.9",
      "glob@>=9 <14.0.2": "^14.0.2",
      "hono": "^4.13.16",
      "ip-address@10": "^10.7.4",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "katex": "^0.18.2",
      "launch-editor": "^2.14.2",
      "lucide-react": "^1.47.0",
      "minimatch@>=7 <11.0.1": "^11.0.1",
      "multer": "^2.5.0",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "postcss-selector-parser@7": "^7.1.6",
      "qs": "^6.16.1",
      "shell-quote": "^1.11.0",
      "solid-js": "1.9.19",
      "uuid@7": "11.1.1",
      "zod@4": "^4.6.7",
      "zod@3": "^4.6.7"
    }
  }
}
