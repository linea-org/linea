{
  "name": "linea",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:up": "pnpm --filter @linea/db db:up",
    "db:down": "pnpm --filter @linea/db db:down",
    "db:logs": "pnpm --filter @linea/db db:logs",
    "db:generate": "pnpm --filter @linea/db db:generate",
    "db:migrate": "pnpm --filter @linea/db db:migrate",
    "db:studio": "pnpm --filter @linea/db db:studio",
    "queue:up": "pnpm --filter @linea/queue queue:up",
    "queue:down": "pnpm --filter @linea/queue queue:down",
    "queue:logs": "pnpm --filter @linea/queue queue:logs",
    "demo": "pnpm --filter @linea/platform-api demo"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
      "esbuild": "0.28.1",
      "hono": "4.12.34",
      "js-yaml@4": "4.3.1",
      "launch-editor": "2.14.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "shell-quote": "1.9.0"
    }
  }
}
