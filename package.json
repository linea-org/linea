{
  "name": "linea",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "prettier --check .",
    "generate:contracts": "pnpm --filter @linea/protocol build && node packages/protocol/scripts/generate-public-contracts.mjs",
    "check:contracts": "pnpm --filter @linea/protocol build && node packages/protocol/scripts/generate-public-contracts.mjs --check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:launch": "node scripts/first-launch-gate.mjs",
    "test:connections-launch": "node scripts/connections-launch-gate.mjs",
    "test:connections-smoke": "node scripts/connections-provider-smoke.mjs",
    "db:up": "pnpm --filter @linea/db db:up",
    "db:down": "pnpm --filter @linea/db db:down",
    "db:logs": "pnpm --filter @linea/db db:logs",
    "db:generate": "pnpm --filter @linea/db db:generate",
    "db:migrate": "pnpm --filter @linea/db db:migrate",
    "db:studio": "pnpm --filter @linea/db db:studio",
    "queue:up": "pnpm --filter @linea/queue queue:up",
    "queue:down": "pnpm --filter @linea/queue queue:down",
    "queue:logs": "pnpm --filter @linea/queue queue:logs",
    "demo": "pnpm --filter @linea/platform-api demo"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "24.22.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "re2"
    ],
    "overrides": {
      "baseline-browser-mapping": "2.11.25",
      "body-parser@2": "^2.4.0",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "browserslist": "4.29.0",
      "engine.io@6": "^6.6.10",
      "esbuild": "0.28.1",
      "fast-uri": "^3.1.9",
      "hono": "^4.13.16",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "launch-editor": "^2.14.2",
      "lucide-react": "^1.47.0",
      "multer": "^2.5.0",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "qs": "^6.16.1",
      "shell-quote": "^1.11.0",
      "uuid@7": "11.1.1",
      "zod@4": "^4.6.6"
    }
  }
}
