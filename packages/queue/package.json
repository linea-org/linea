{
  "name": "@linealabs/queue",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "queue:up": "docker compose --env-file ../../docker/.env -f ../../docker-compose.yml up -d redis",
    "queue:down": "docker compose --env-file ../../docker/.env -f ../../docker-compose.yml down",
    "queue:logs": "docker compose --env-file ../../docker/.env -f ../../docker-compose.yml logs -f redis"
  },
  "dependencies": {
    "bullmq": "^5",
    "ioredis": "^5"
  },
  "devDependencies": {
    "@linealabs/config": "workspace:*",
    "@types/node": "26",
    "dotenv": "18.0.10",
    "eslint": "^9",
    "tsup": "^8.5.0",
    "typescript": "^6",
    "vitest": "^4.1.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
