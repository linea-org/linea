{
  "name": "@linealabs/config",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/eslint.ts --format esm --dts --clean --sourcemap --target es2022",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
