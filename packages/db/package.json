{
  "name": "@linealabs/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose --env-file ../../docker/.env -f ../../docker-compose.yml up -d postgres",
    "db:down": "docker compose --env-file ../../docker/.env -f ../../docker-compose.yml down",
    "db:logs": "docker compose --env-file ../../docker/.env -f ../../docker-compose.yml logs -f postgres"
  },
  "dependencies": {
    "@linealabs/protocol": "workspace:*",
    "ajv": "8.20.0",
    "cron-parser": "^5.10.6",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@linealabs/config": "workspace:*",
    "@types/node": "26",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.10",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "10",
    "tsup": "^8.5.0",
    "typescript": "6",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./clients": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./relations": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "drizzle"
  ]
}
