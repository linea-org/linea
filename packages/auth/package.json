{
  "name": "@linealabs/auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.22",
    "@better-auth/expo": "1.7.22",
    "@linealabs/db": "workspace:*",
    "better-auth": "^1.7.22",
    "drizzle-orm": "1.0.0-rc.4",
    "ioredis": "^5",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@linealabs/config": "workspace:*",
    "@types/node": "26",
    "dotenv": "18.0.10",
    "eslint": "9",
    "tsup": "^8.5.0",
    "typescript": "6",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auth": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "import": "./dist/email.js",
      "require": "./dist/email.cjs"
    },
    "./session-policy": {
      "types": "./dist/session-policy.d.ts",
      "import": "./dist/session-policy.js",
      "require": "./dist/session-policy.cjs"
    },
    "./personal-workspace": {
      "types": "./dist/personal-workspace.d.ts",
      "import": "./dist/personal-workspace.js",
      "require": "./dist/personal-workspace.cjs"
    },
    "./emails": {
      "types": "./dist/emails.d.ts",
      "import": "./dist/emails.js",
      "require": "./dist/emails.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "assets"
  ]
}
