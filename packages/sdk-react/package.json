{
  "name": "@linea/sdk-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pack": "node test/packed-react.mjs && node test/packed-copilotkit.mjs"
  },
  "peerDependencies": {
    "@copilotkit/react-core": "^1.73.0",
    "react": "^18.3.0 || ^19.0.0",
    "zod": ">=3.25.0"
  },
  "peerDependenciesMeta": {
    "@copilotkit/react-core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@linea/protocol": "workspace:*",
    "@linea/sdk": "workspace:*"
  },
  "devDependencies": {
    "@copilotkit/react-core": "^1.73.0",
    "@linea/config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "jsdom": "^26.1.0",
    "msw": "^2.11.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsup": "^8.5.0",
    "typescript": "^6",
    "vitest": "^3",
    "zod": "^4.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./copilotkit": {
      "types": "./dist/copilotkit.d.ts",
      "import": "./dist/copilotkit.js",
      "require": "./dist/copilotkit.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
