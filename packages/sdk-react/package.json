{
  "name": "@linealabs/sdk-react",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linea-org/linea.git",
    "directory": "packages/sdk-react"
  },
  "homepage": "https://docs.getlinea.app",
  "bugs": "https://github.com/linea-org/linea/issues",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pack": "node test/packed-react.mjs"
  },
  "peerDependencies": {
    "@copilotkit/react-core": "^1.89.0",
    "react": "^18.3.0 || ^19.0.0",
    "zod": ">=3.25.0"
  },
  "peerDependenciesMeta": {
    "@copilotkit/react-core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@linealabs/sdk": "workspace:^"
  },
  "devDependencies": {
    "@copilotkit/react-core": "^1.89.0",
    "@linealabs/config": "workspace:*",
    "@linealabs/protocol": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "jsdom": "^26.1.0",
    "msw": "^2.11.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6",
    "vitest": "^5.1.1",
    "zod": "^4.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./copilotkit": {
      "types": "./dist/copilotkit.d.ts",
      "import": "./dist/copilotkit.js",
      "require": "./dist/copilotkit.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "description": "React hooks and components for Linea End-User conversations and approvals."
}
