{
  "name": "@linealabs/sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linea-org/linea.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.getlinea.app",
  "bugs": "https://github.com/linea-org/linea/issues",
  "private": true,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pack": "node test/packed-browser.mjs && node test/packed-server.mjs"
  },
  "devDependencies": {
    "@linealabs/config": "workspace:*",
    "@linealabs/protocol": "workspace:*",
    "@types/node": "26",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "tsup": "^9.0.0",
    "typescript": "^6",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./user": {
      "types": "./dist/user.d.ts",
      "import": "./dist/user.js",
      "require": "./dist/user.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "description": "Linea SDK: create, run and watch Workflows, and build End-User approval flows."
}
