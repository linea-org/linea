PORT=3000
DATABASE_URL="postgresql://linea:linea@localhost:5432/linea"
REDIS_URL="redis://localhost:6379"

BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Public auth URL = web app; Vite/dev proxy forwards /api/auth → Nest.
BETTER_AUTH_URL="http://localhost:3001"
APP_URL="http://localhost:3001"
TRUSTED_ORIGINS="http://localhost:3001,http://localhost:3000"
# Optional reverse-proxy IPs/CIDRs for X-Forwarded-For (production only)
# TRUSTED_PROXIES="10.0.0.0/8,192.168.0.1"

# OAuth (Google Cloud Console / GitHub OAuth Apps)
# Callback URLs (local): http://localhost:3001/api/auth/callback/google
#                        http://localhost:3001/api/auth/callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Web (Vite)
VITE_API_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3001"

RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Linea <onboarding@resend.dev>"
EMAIL_BRAND_NAME="Linea"
EMAIL_SUPPORT_EMAIL="contact@getlinea.app"
